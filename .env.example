# 生产 canonical、OG 与 sitemap 的统一站点 URL。
NUXT_SITE_URL=https://www.explorer.nubit.org
# 预发布环境保持 false；生产部署确认域名和链网络后改为 true。
NUXT_SITE_INDEXABLE=false
NUXT_PUBLIC_API_BASE=https://alphatestnet-api.nubit.org/v1
NUXT_PUBLIC_WS_URL=wss://alphatestnet-api.nubit.org/v1/ws
# OG 图片签名需要至少 32 字符的随机值；多实例保持相同，勿提交真实密钥。
NUXT_APP_SECRET=
